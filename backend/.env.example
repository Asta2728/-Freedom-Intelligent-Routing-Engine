# Environment Configuration

# Application settings
ENVIRONMENT=local
DEBUG=True
API_V1_STR=/api/v1

# Database Configuration
DB_TYPE=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=datasaur

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AI Agent (OpenAI - used by /api/v1/chat and /ws/agent)
OPENAI_API_KEY=
OPENAI_BASE_URL=
AGENT_MODEL=gpt-4o-mini

# Worker / FIRE pipeline (DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Vision / Image Analysis (Gemini) — used by FIRE ingestion when images are uploaded
# Leave GEMINI_API_KEY empty to disable image description entirely (safe fallback)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
